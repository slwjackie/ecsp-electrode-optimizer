ninja_required_version = 1.3
cxx = c++

cflags = -DTORCH_EXTENSION_NAME=ecsp_bc_native_ecaa77b78880a2a3 -DTORCH_API_INCLUDE_EXTENSION_H -isystem /Users/kimjiin/anaconda3/envs/ecsp-m2/lib/python3.10/site-packages/torch/include -isystem /Users/kimjiin/anaconda3/envs/ecsp-m2/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -isystem /Users/kimjiin/anaconda3/envs/ecsp-m2/include/python3.10 -fPIC -std=c++20 -O3 -std=c++20 -ffp-contract=off
post_cflags = 
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = -shared -L/Users/kimjiin/anaconda3/envs/ecsp-m2/lib/python3.10/site-packages/torch/lib -lc10 -ltorch_cpu -ltorch -ltorch_python -undefined dynamic_lookup

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc





rule link
  command = $cxx $in $ldflags -o $out

build bindings.o: compile /Users/kimjiin/Desktop/ECSP_v8_4_2_A100CPU8_GeometrySafe/cpp/bc_native/bindings.cpp
build bc_engine.o: compile /Users/kimjiin/Desktop/ECSP_v8_4_2_A100CPU8_GeometrySafe/cpp/bc_native/bc_engine.cpp
build bc_ops_cpu.o: compile /Users/kimjiin/Desktop/ECSP_v8_4_2_A100CPU8_GeometrySafe/cpp/bc_native/bc_ops_cpu.cpp





build ecsp_bc_native_ecaa77b78880a2a3.so: link bindings.o bc_engine.o bc_ops_cpu.o

default ecsp_bc_native_ecaa77b78880a2a3.so
