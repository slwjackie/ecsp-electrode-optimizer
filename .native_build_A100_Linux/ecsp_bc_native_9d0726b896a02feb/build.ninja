ninja_required_version = 1.3
cxx = c++
nvcc = /usr/local/cuda-13.0/bin/nvcc

cflags = -DTORCH_EXTENSION_NAME=ecsp_bc_native_9d0726b896a02feb -DTORCH_API_INCLUDE_EXTENSION_H -isystem /ECSP/.venv/lib/python3.10/site-packages/torch/include -isystem /ECSP/.venv/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -isystem /usr/local/cuda-13.0/include -isystem /usr/include/python3.10 -fPIC -std=c++20 -O3 -std=c++20 -ffp-contract=off -DWITH_CUDA
post_cflags = 
cuda_cflags = -DTORCH_EXTENSION_NAME=ecsp_bc_native_9d0726b896a02feb -DTORCH_API_INCLUDE_EXTENSION_H -isystem /ECSP/.venv/lib/python3.10/site-packages/torch/include -isystem /ECSP/.venv/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -isystem /usr/local/cuda-13.0/include -isystem /usr/include/python3.10 -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr -gencode=arch=compute_80,code=sm_80 --compiler-options '-fPIC' -O3 -std=c++20 -DWITH_CUDA --fmad=false
cuda_post_cflags = 
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = -shared -L/ECSP/.venv/lib/python3.10/site-packages/torch/lib -lc10 -lc10_cuda -ltorch_cpu -ltorch_cuda -ltorch -ltorch_python -L/usr/local/cuda-13.0/lib64 -lcudart

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc -MD -MF $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags





rule link
  command = $cxx $in $ldflags -o $out

build bindings.o: compile /ECSP/ECSP_v8_4_2_A100CPU8_GeometrySafe/cpp/bc_native/bindings.cpp
build bc_engine.o: compile /ECSP/ECSP_v8_4_2_A100CPU8_GeometrySafe/cpp/bc_native/bc_engine.cpp
build bc_ops_cpu.o: compile /ECSP/ECSP_v8_4_2_A100CPU8_GeometrySafe/cpp/bc_native/bc_ops_cpu.cpp
build bc_ops_cuda.cuda.o: cuda_compile /ECSP/ECSP_v8_4_2_A100CPU8_GeometrySafe/cpp/bc_native/bc_ops_cuda.cu





build ecsp_bc_native_9d0726b896a02feb.so: link bindings.o bc_engine.o bc_ops_cpu.o bc_ops_cuda.cuda.o

default ecsp_bc_native_9d0726b896a02feb.so
