def _strict_resource_integer(raw: Any, name: str, minimum: int, maximum: int) -> int:
    if isinstance(raw, bool):
        raise ValueError(f"{name} must be an integer in [{minimum}, {maximum}]")
    try:
        numeric = float(raw)
    except (TypeError, ValueError, OverflowError) as exc:
        raise ValueError(
            f"{name} must be an integer in [{minimum}, {maximum}]"
        ) from exc
    if (
        not math.isfinite(numeric)
        or not numeric.is_integer()
        or numeric < minimum
        or numeric > maximum
    ):
        raise ValueError(f"{name} must be an integer in [{minimum}, {maximum}]")
    return int(numeric)


def _bc_resource_limits(config: Mapping[str, Any]) -> tuple[int, int]:
    quality = config.get("numericalQuality", {})
    if not isinstance(quality, Mapping):
        raise ValueError("numericalQuality must be a mapping")
    maximum_steps = _strict_resource_integer(
        quality.get("maximumTimeSteps", _BC_DEFAULT_MAXIMUM_TIME_STEPS),
        "numericalQuality.maximumTimeSteps",
        1,
        _BC_NATIVE_STEP_LIMIT,
    )
    maximum_history_bytes = _strict_resource_integer(
        quality.get(
            "maximumHistoryAllocationBytes",
            _BC_DEFAULT_MAXIMUM_HISTORY_ALLOCATION_BYTES,
        ),
        "numericalQuality.maximumHistoryAllocationBytes",
        8 * len(BC_SCALAR_HISTORY_FIELDS),
        (1 << 63) - 1,
    )
    return maximum_steps, maximum_history_bytes


def _positive_time_step_count(
    duration: float,
    step_size: float,
    *,
    maximum_steps: int = _BC_NATIVE_STEP_LIMIT,
) -> int:
    """Return a ceil-like count without a spurious zero-duration final step."""
    if (
        not math.isfinite(duration)
        or not math.isfinite(step_size)
        or duration <= 0.0
        or step_size <= 0.0
    ):
        raise ValueError("B/C duration and time step must be finite and positive")
    ratio = duration / step_size
    if not math.isfinite(ratio) or ratio <= 0.0:
        raise ValueError("B/C derived time-step ratio is non-finite or non-positive")
    nearest = round(ratio)
    tolerance = 64.0 * math.ulp(1.0) * max(1.0, abs(ratio))
    if abs(ratio - nearest) <= tolerance:
        count = max(1, int(nearest))
    else:
        count = max(1, int(math.floor(ratio)) + 1)
    if count > maximum_steps:
        raise ValueError(
            "B/C time-step count exceeds numericalQuality.maximumTimeSteps: "
            f"count={count}, maximum={maximum_steps}"
        )
    return count


def _is_time_grid_aligned(value: float, step_size: float) -> bool:
    if (
        not math.isfinite(value)
        or not math.isfinite(step_size)
        or step_size <= 0.0
    ):
        return False
    ratio = value / step_size
    if not math.isfinite(ratio):
        return False
    tolerance = 64.0 * math.ulp(1.0) * max(1.0, abs(ratio))
    return abs(ratio - round(ratio)) <= tolerance


def _time_match_tolerance(*values: float) -> float:
    """Return an ULP-scale tolerance without a one-second absolute floor."""
    return 64.0 * max(math.ulp(abs(float(value))) for value in values)


def _require_unclipped_faradaic_inventory(
    lp_limited: torch.Tensor,
    water_limited: torch.Tensor,
    *,
    step: int,
    step_dt: float,
) -> None:
    """Fail before committing a Faradaic extent not supported by inventory.

    Clipping only the species sink would leave the nonlinear BV current,
    electrical field and input-energy integral at the rejected value.  Until
    an inventory-constrained BV boundary is solved self-consistently, returning
    such a state is physically inconsistent; production therefore fails
    closed and asks for a time step small enough to resolve depletion.
    """
    limited = lp_limited | water_limited
    if bool(torch.any(limited).item()):
        batch_counts = limited.flatten(1).sum(dim=1)
        bad = torch.nonzero(batch_counts > 0).flatten().detach().cpu().tolist()
        counts = batch_counts[batch_counts > 0].detach().cpu().tolist()
        raise BCCandidateBatchError(
            "Faradaic inventory depletion would clip reaction current without "
            "a self-consistent BV/potential re-solve; refusing an inconsistent "
            f"state at step={step}, step_dt={step_dt}, batch_indices={bad}, "
            f"limited_cells={counts}. Reduce bcGlobal.timeStep_s or use an "
            "inventory-constrained electrochemical boundary solver.",
            bad,
            "faradaic_inventory_depletion",
        )


